# ==============================================================================
# AI Editorial Workspace — Environment Variables Configuration
# ==============================================================================

# AI Model Provider Configuration
# Choose your active provider: "anthropic" | "openai" | "heuristic"
# (If neither key is supplied, the built-in high-fidelity Heuristic Engine operates automatically)
AI_MODEL_PROVIDER="anthropic"

# Anthropic Claude API (Recommended for nuanced editorial analysis)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# OpenAI API Key (Alternative for GPT-4o synthesis)
OPENAI_API_KEY="sk-proj-..."

# Supabase / PostgreSQL Persistence (Optional)
# If left blank, the application automatically uses the atomic local file database (.data/editorial-store.json)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
